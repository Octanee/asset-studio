# Copy to .env and change the values. .env is git-ignored.
ASSET_STUDIO_DB_PASSWORD=change-me
# The library lives in the Docker volume 'asset-data' (ADR-013).
ASSET_STUDIO_WEB_PORT=8480
ASSET_STUDIO_API_PORT=8400
ASSET_STUDIO_DB_PORT=5433

# Per-install secrets (ADR-012). Generate long random values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ASSET_STUDIO_SESSION_SECRET=change-me
ASSET_STUDIO_MCP_TOKEN=
# Claude Code connects to http://127.0.0.1:<port>/mcp with the MCP token as a bearer token.
ASSET_STUDIO_MCP_PORT=8411
ASSET_STUDIO_WORKER_TOKEN=

# Generation engine (ADR-005). ComfyUI and the host agent run natively on 127.0.0.1;
# the containers reach them as host.docker.internal. 'fake' needs no GPU (development).
ASSET_STUDIO_ENGINE_PROVIDER=comfyui
ASSET_STUDIO_COMFYUI_PORT=8188
ASSET_STUDIO_AGENT_PORT=8410
# The same token goes to the host agent (ASSET_STUDIO_AGENT_TOKEN in its own .env).
ASSET_STUDIO_AGENT_TOKEN=

# Model folder in the ComfyUI layout (checkpoints, loras, controlnet, ...), shared with ComfyUI.
# Point it at ComfyUI's models folder; downloads you approve are written there.
ASSET_STUDIO_MODELS_HOST_DIR=./models

# Export folder (ADR-013): publishing targets are folders inside it. Choose a Windows folder,
# e.g. the assets folder of your product's repository.
ASSET_STUDIO_EXPORTS_HOST_DIR=./exports

# Pose detection models (DWPose) live in the library volume under models/pose; install them with
#   docker compose run --rm worker python -m asset_studio.modules.poses.install
